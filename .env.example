# Your association's ProBo site
PROBO_BASE_URL=https://your-association.probo.dk

# 1Password secret references (resolved by the server, or by `op run --env-file .env -- ...`).
# Plain values work too.
PROBO_USERNAME=op://Private/ProBo/username
PROBO_PASSWORD=op://Private/ProBo/password

# Optional
# PROBO_DOWNLOAD_DIR=~/Downloads/probo
# PROBO_MAX_DOCUMENT_CHARS=50000
# PROBO_CONFIRM_DOWNLOAD_MB=10
# PROBO_CACHE_SECONDS=60
# PROBO_LOG_LEVEL=WARNING
