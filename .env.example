# Your association's ProBo site
PROBO_BASE_URL=https://your-association.probo.dk

PROBO_USERNAME=you@example.com

# The password: best kept out of this file. Either
#   - leave PROBO_PASSWORD unset and save it once with `probo-mcp --set-password` (system keychain), or
#   - use a 1Password reference, which the server resolves itself (load this file with
#     `uv run --env-file .env probo-mcp`; not `op run`, which puts the real password in the environment):
# PROBO_PASSWORD=op://Private/ProBo/password
# Never put the password itself here: anything that can read files as you, AI agents included, can read it.

# Optional
# PROBO_DOWNLOAD_DIR=~/Downloads/probo
# PROBO_ARCHIVE_DIR=~/Documents/probo
# PROBO_MAX_DOCUMENT_CHARS=50000
# PROBO_CONFIRM_DOWNLOAD_MB=10
# PROBO_CACHE_SECONDS=60
# PROBO_LOG_LEVEL=WARNING
